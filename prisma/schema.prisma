// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String                        @id @default(uuid())
  name                String
  createdAt           DateTime                      @default(now())
  users               User[]
  documents           Document[]
  auditLogs           AuditLog[]
  deviations          Deviation[]
  capas               CAPA[]
  equipment           Equipment[]
  suppliers           Supplier[]
  auditPlans          AuditPlan[]
  notifications       Notification[]
  regulatoryAssessments TenantRequirementAssessment[]
}

model User {
  id                      String               @id @default(uuid())
  email                   String               @unique
  fullName                String
  firstName               String?
  lastName                String?
  phone                   String?
  profilePicture          String?
  mfaEnabled              Boolean              @default(false)
  accountStatus           String               @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, PENDING_INVITATION
  role                    String               // e.g. "ADMIN", "OWNER", "QUALITY_MANAGER", "QA_REVIEWER", "DOCUMENT_OWNER", "DEPARTMENT_MANAGER", "TRAINING_COORDINATOR", "INVESTIGATOR", "APPROVER", "EMPLOYEE", "EXTERNAL_AUDITOR", "SUPPLIER", "CONSULTANT"
  department              String               // e.g. "QA", "QC", "PRODUCTION", "REGULATORY", "ENGINEERING"
  businessUnit            String?
  site                    String               @default("Main Facility") // e.g. "Dublin Lab A", "Frankfurt Plant 2"
  location                String?
  country                 String?              @default("Germany")
  employmentType          String               @default("EMPLOYEE") // EMPLOYEE, CONTRACTOR, CONSULTANT, EXTERNAL_AUDITOR, SUPPLIER
  trainingStatus          String               @default("QUALIFIED")
  digitalSignatureEnabled Boolean              @default(true)
  signatureAuthorityLevel String               @default("LEVEL_1")
  approvalAuthorityLevel  String               @default("LEVEL_1")
  clearance               String               @default("INTERNAL") // e.g. "INTERNAL", "RESTRICTED"
  expiresAt               DateTime?            // For temporary Consultant / External Auditor access
  tenantId                String
  tenant                  Tenant               @relation(fields: [tenantId], references: [id])
  documentOwner           Document[]           @relation("DocumentOwner")
  approvals               ApprovalRouteStep[]
  signatures              SignatureManifest[]
  trainingAssignments     TrainingAssignment[]
  quizResults             QuizResult[]
  deviationsDetected      Deviation[]          @relation("DetectedBy")
  deviationsInvestigated  Deviation[]          @relation("Investigator")
  capasAssigned           CAPA[]               @relation("CapaAssigned")
  maintenanceLogs         MaintenanceLog[]     @relation("PerformedMaintenance")
  supplierAudits          SupplierAudit[]      @relation("AuditedSupplier")
  materialInspections     MaterialReceipt[]    @relation("InspectedMaterial")
  auditsLead              AuditPlan[]          @relation("LeadAuditor")
  notifications           Notification[]
  requirementAssessments TenantRequirementAssessment[] @relation("RequirementOwner")
}

model Document {
  id                   String                  @id @default(uuid())
  title                String
  description          String
  classification       String                  // e.g. "CONTROLLED", "INTERNAL", "HIGHLY_RESTRICTED"
  status               String                  // e.g. "DRAFT", "IN_REVIEW", "APPROVED", "EFFECTIVE", "OBSOLETE"
  ownerId              String
  owner                User                    @relation("DocumentOwner", fields: [ownerId], references: [id])
  tenantId             String
  tenant               Tenant                  @relation(fields: [tenantId], references: [id])
  versions             DocumentVersion[]
  currentVersionNumber Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  trainingRequirement  TrainingRequirement?
  changeRequests       ChangeRequestDocument[]
}

model DocumentVersion {
  id                String             @id @default(uuid())
  documentId        String
  document          Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber     Int
  filePath          String
  fileData          String?            // Base64 encoded file content
  hash              String             // SHA-256 integrity hash
  createdAt         DateTime           @default(now())
  createdBy         String
  signatureManifest SignatureManifest?
  approvalRoutes    ApprovalRoute[]
}

model ApprovalRoute {
  id                String              @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  steps             ApprovalRouteStep[]
  status            String              // e.g. "PENDING", "APPROVED", "REJECTED"
  createdAt         DateTime            @default(now())
}

model ApprovalRouteStep {
  id              String        @id @default(uuid())
  approvalRouteId String
  approvalRoute   ApprovalRoute @relation(fields: [approvalRouteId], references: [id], onDelete: Cascade)
  approverId      String
  approver        User          @relation(fields: [approverId], references: [id])
  sequence        Int
  status          String        // e.g. "PENDING", "APPROVED", "REJECTED"
  signedAt        DateTime?
  comment         String?
}

model SignatureManifest {
  id                String          @id @default(uuid())
  documentVersionId String          @unique
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  signedBy          String
  signer            User            @relation(fields: [signedBy], references: [id])
  signedAt          DateTime        @default(now())
  meaning           String          // e.g. "Authorship", "Approval", "Review"
  hashSigned        String
  ipAddress         String
}

model TrainingRequirement {
  id              String               @id @default(uuid())
  documentId      String               @unique
  document        Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requiredForRoles String               // Comma-separated roles or departments
  requiresQuiz    Boolean              @default(false)
  quizQuestions   String?              // JSON string containing questions, options, and correct answers
  assignments     TrainingAssignment[]
}

model TrainingAssignment {
  id            String              @id @default(uuid())
  requirementId String
  requirement   TrainingRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String              // e.g. "ASSIGNED", "COMPLETED", "OVERDUE"
  assignedAt    DateTime            @default(now())
  completedAt   DateTime?
  quizResultId  String?             @unique
  quizResult    QuizResult?         @relation(fields: [quizResultId], references: [id])
}

model QuizResult {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  score              Int
  passed             Boolean
  createdAt          DateTime            @default(now())
  trainingAssignment TrainingAssignment?
}

model ChangeRequest {
  id        String                  @id @default(uuid())
  title     String
  reason    String
  riskLevel String                  // e.g. "LOW", "MEDIUM", "HIGH"
  status    String                  // e.g. "DRAFT", "UNDER_REVIEW", "APPROVED", "CLOSED"
  createdAt DateTime                @default(now())
  documents ChangeRequestDocument[]
}

model ChangeRequestDocument {
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  documentId      String
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, documentId])
}

model Deviation {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  title              String
  description        String
  classification     String   // e.g. "MINOR", "MAJOR", "CRITICAL"
  status             String   // e.g. "LOGGED", "UNDER_INVESTIGATION", "QA_REVIEW", "CLOSED"
  detectedById       String
  detectedBy         User     @relation("DetectedBy", fields: [detectedById], references: [id])
  investigatorId     String?
  investigator       User?    @relation("Investigator", fields: [investigatorId], references: [id])
  investigationNotes String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  capas              CAPA[]
  equipmentId        String?
  equipment          Equipment? @relation("EquipmentDeviations", fields: [equipmentId], references: [id])
}

model CAPA {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  title         String
  actionPlan    String
  status        String         // e.g. "OPEN", "IN_PROGRESS", "CLOSED"
  dueDate       DateTime
  completedAt   DateTime?
  assignedToId  String
  assignedTo    User           @relation("CapaAssigned", fields: [assignedToId], references: [id])
  deviationId   String?
  deviation     Deviation?     @relation(fields: [deviationId], references: [id], onDelete: Cascade)
  auditFindings AuditFinding[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  eventId     String   @unique // UUID for client-side correlation and WORM checks
  timestamp   DateTime @default(now())
  userId      String?
  userEmail   String?
  userRole    String?
  action      String   // e.g. Document.Create, Document.View, ESign.Execute
  objectType  String   // e.g. Document, User, Tenant
  objectId    String?
  payload     String   // JSON payload (includes before/after for CUD, fieldsReturned for reads)
  status      String   // Success, Failed, Denied
  sourceIp    String?
  requestUrl  String?
}

model Equipment {
  id                      String           @id @default(uuid())
  tenantId                String
  tenant                  Tenant           @relation(fields: [tenantId], references: [id])
  name                    String
  description             String?
  modelNumber             String?
  serialNumber            String?
  location                String           // e.g. "Cleanroom Suite A"
  status                  String           // e.g. "ACTIVE", "OUT_OF_SERVICE", "UNDER_MAINTENANCE", "CALIBRATION_DUE"
  calibrationIntervalDays Int              // e.g. 90, 180, 365
  lastCalibratedAt        DateTime         @default(now())
  nextCalibrationDueDate  DateTime
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  maintenanceLogs         MaintenanceLog[]
  deviations              Deviation[]      @relation("EquipmentDeviations")
}

model MaintenanceLog {
  id              String    @id @default(uuid())
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedById   String
  performedBy     User      @relation("PerformedMaintenance", fields: [performedById], references: [id])
  performedAt     DateTime  @default(now())
  activityType    String    // e.g. "CALIBRATION", "PREVENTATIVE_MAINTENANCE", "REPAIR"
  notes           String
  result          String    // e.g. "PASS", "FAIL"
  esignSignatureId String?   // 21 CFR Part 11 signature record if signed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Supplier {
  id                      String            @id @default(uuid())
  tenantId                String
  tenant                  Tenant            @relation(fields: [tenantId], references: [id])
  name                    String
  contactEmail            String?
  contactPhone            String?
  category                String            // e.g. "RAW_MATERIAL", "PACKAGING", "CONTRACT_LAB", "SOFTWARE"
  status                  String            // e.g. "APPROVED", "CONDITIONALLY_APPROVED", "UNDER_EVALUATION", "DISQUALIFIED"
  riskClassification      String            // e.g. "CRITICAL", "MAJOR", "MINOR"
  qualificationDate       DateTime          @default(now())
  reEvaluationDueDate     DateTime
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  audits                  SupplierAudit[]
  materialReceipts        MaterialReceipt[]
  attachments             SupplierAttachment[]
}

model SupplierAttachment {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   String
  fileData   String   // Base64 encoded file content
  uploadedAt DateTime @default(now())
}

model SupplierAudit {
  id               String   @id @default(uuid())
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  auditorId        String
  auditor          User     @relation("AuditedSupplier", fields: [auditorId], references: [id])
  auditDate        DateTime @default(now())
  auditType        String   // e.g. "INITIAL_QUALIFICATION", "ROUTINE_ANNUAL", "FOR_CAUSE"
  findings         String
  result           String   // e.g. "PASS", "CONDITIONAL_PASS", "FAIL"
  esignSignatureId String?  // 21 CFR Part 11 signature record if signed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MaterialReceipt {
  id               String   @id @default(uuid())
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  materialName     String
  lotNumber        String
  quantityReceived Int
  unit             String   // e.g. "kg", "L", "units"
  inspectionStatus String   // e.g. "PASSED", "REJECTED", "QUARANTINE"
  inspectedById    String
  inspectedBy      User     @relation("InspectedMaterial", fields: [inspectedById], references: [id])
  notes            String?
  receivedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditPlan {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  title           String
  scope           String         // e.g. "EU GMP Annex 11 / ISO 13485 Internal Audit"
  auditType       String         // e.g. "INTERNAL", "SUPPLIER", "REGULATORY_PREPARATION"
  status          String         // e.g. "PLANNED", "IN_PROGRESS", "REPORT_GENERATED", "CLOSED"
  scheduledDate   DateTime
  completedDate   DateTime?
  leadAuditorId   String
  leadAuditor     User           @relation("LeadAuditor", fields: [leadAuditorId], references: [id])
  summary         String?
  findings        AuditFinding[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AuditFinding {
  id           String    @id @default(uuid())
  auditPlanId  String
  auditPlan    AuditPlan @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  classification String  // e.g. "CRITICAL", "MAJOR", "MINOR", "RECOMMENDATION"
  description  String
  capaId       String?
  capa         CAPA?     @relation(fields: [capaId], references: [id])
  status       String    // e.g. "OPEN", "CAPA_LINKED", "RESOLVED"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // e.g. "TRAINING_OVERDUE", "DOCUMENT_REVIEW", "CAPA_DUE", "CALIBRATION_ALERT"
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ==========================================
// REGULATORY INTEL - GLOBAL REGULATOR LAYER (Tenant-independent)
// ==========================================

model Regulation {
  id           String              @id @default(uuid())
  regulationId String              @unique // e.g. "EU-GMP-VOL4"
  name         String
  authority    String              // e.g. "European Commission"
  jurisdiction String              // e.g. "European Union"
  status       String              @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  versions     RegulationVersion[]
}

model RegulationVersion {
  id                String              @id @default(uuid())
  regulationId      String
  regulation        Regulation          @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  versionNumber     String              // e.g. "2024.1"
  publicationDate   DateTime
  effectiveDate     DateTime
  status            String              @default("ACTIVE") // ACTIVE, SUPERSEDED
  previousVersionId String?             @unique
  previousVersion   RegulationVersion?  @relation("VersionSequence", fields: [previousVersionId], references: [id])
  nextVersion       RegulationVersion?  @relation("VersionSequence")
  chapters          Chapter[]
  sourceDocuments   SourceDocument[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model SourceDocument {
  id                  String            @id @default(uuid())
  regulationVersionId String
  regulationVersion   RegulationVersion @relation(fields: [regulationVersionId], references: [id], onDelete: Cascade)
  fileName            String
  filePath            String
  fileType            String
  contentHash         String?
  uploadedAt          DateTime          @default(now())
}

model Chapter {
  id                  String            @id @default(uuid())
  regulationVersionId String
  regulationVersion   RegulationVersion @relation(fields: [regulationVersionId], references: [id], onDelete: Cascade)
  chapterNumber       String            // e.g. "Chapter 4", "Annex 11"
  title               String
  sections            Section[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Section {
  id            String        @id @default(uuid())
  chapterId     String
  chapter       Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sectionNumber String        // e.g. "4.1", "Clause 3"
  title         String
  requirements  Requirement[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Requirement {
  id                 String                        @id @default(uuid())
  requirementId      String                        @unique // e.g. "REQ-EU-GMP-CH4-V2024.1-P4.1-1"
  sectionId          String
  section            Section                       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  paragraphReference String                        // e.g. "Paragraph 4.1"
  originalWording    String                        // Immutable regulatory text
  pageNumber         Int?
  riskClassification String                        // CRITICAL, MAJOR, MINOR
  category           String
  keywords           String                        // Comma-separated or JSON array list
  qualityArea        String
  importDate         DateTime                      @default(now())
  parserVersion      String                        @default("1.0")
  assessments        TenantRequirementAssessment[]
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
}

// ==========================================
// REGULATORY INTEL - TENANT COMPLIANCE LAYER (Customer-specific)
// ==========================================

model TenantRequirementAssessment {
  id                   String                     @id @default(uuid())
  tenantId             String
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirementId        String
  requirement          Requirement                @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  applicability        String                     @default("NOT_ASSESSED") // NOT_ASSESSED, UNDER_REVIEW, APPLICABLE, NOT_APPLICABLE
  justification        String?                    // Mandatory if NOT_APPLICABLE
  implementationStatus String                     @default("NOT_STARTED") // NOT_STARTED, UNDER_REVIEW, MAPPED, IMPLEMENTED, VERIFIED, MONITORING
  interpretation       String?                    // Plain-language corporate interpretation
  aiInterpretation     String?                    // AI-drafted interpretation proposal
  ownerId              String?
  owner                User?                      @relation("RequirementOwner", fields: [ownerId], references: [id])
  reviewDate           DateTime?
  comments             String?
  mappings             TenantRequirementMapping[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([tenantId, requirementId])
}

model TenantRequirementMapping {
  id           String                      @id @default(uuid())
  tenantId     String
  assessmentId String
  assessment   TenantRequirementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  targetType   String                      // DOCUMENT, TRAINING_REQUIREMENT, PROCESS, RISK, CAPA, AUDIT_PLAN, VALIDATION, EQUIPMENT, SUPPLIER
  targetId     String                      // ID of the target QMS record
  targetTitle  String                      // Cached display name
  mappingType  String                      @default("SATISFIES") // SATISFIES, VERIFIES, MITIGATES, APPLIES_TO
  createdAt    DateTime                    @default(now())
}

model IamUser {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  mfaEnabled         Boolean         @default(false)
  mfaSecret          String?         // TOTP key or secret
  accountStatus      String          @default("INVITED") // INVITED, ACTIVE, SUSPENDED, DEACTIVATED
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  lastLogin          DateTime?
  lastPasswordChange DateTime?
  memberships        IamMembership[]
  sessions           IamSession[]
  auditTrails        IamAuditTrail[]
}

model IamOrganization {
  id               String                   @id @default(uuid())
  legalName        String
  companyName      String
  country          String
  industry         String
  size             String
  subscriptionPlan String                   @default("TRIAL") // TRIAL, ACTIVE, ENTERPRISE
  status           String                   @default("TRIAL") // TRIAL, ACTIVE, SUSPENDED, ARCHIVED
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  memberships      IamMembership[]
  subscriptions    IamProductSubscription[]
  auditTrails      IamAuditTrail[]
}

model IamMembership {
  id             String          @id @default(uuid())
  userId         String
  user           IamUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   IamOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           IamRole         @relation(fields: [roleId], references: [id])
  status         String          @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  createdBy      String?
  approvedBy     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, organizationId])
}

model IamProductSubscription {
  id             String          @id @default(uuid())
  organizationId String
  organization   IamOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productName    String          // VERITAS, NEXUS, GENESIS
  status         String          @default("INACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, productName])
}

model IamRole {
  id          String                  @id @default(uuid())
  name        String                  @unique // e.g. "Organization Owner", "Quality Manager", "Employee"
  description String
  isSystem    Boolean                 @default(false)
  memberships IamMembership[]
  permissions IamRolePermission[]
}

model IamPermission {
  id          String                  @id @default(uuid())
  name        String                  @unique // e.g. "DOCUMENT_VIEW", "USER_INVITE"
  description String
  roles       IamRolePermission[]
}

model IamRolePermission {
  roleId       String
  role         IamRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   IamPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model IamSession {
  id           String    @id @default(uuid())
  userId       String
  user         IamUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  location     String?   @default("Unknown")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
}

model IamAuditTrail {
  id             String           @id @default(uuid())
  organizationId String?
  organization   IamOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           IamUser?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail      String
  userRole       String?
  action         String           // e.g. LOGIN, USER_INVITED, ROLE_ASSIGNED
  objectType     String           // e.g. User, Organization, Membership
  objectId       String?
  payload        String           // JSON string of metadata (e.g. before/after, reason)
  status         String           @default("SUCCESS") // SUCCESS, FAILED, DENIED
  ipAddress      String?
  reason         String?
  createdAt      DateTime         @default(now())
}

