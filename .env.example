# Required in every deployed environment. Use a PostgreSQL connection string
# scoped to that environment; previews must never use the production database.
DATABASE_URL=

# Required for controlled document upload and retrieval. Use an environment-
# scoped private Vercel Blob store/token.
BLOB_READ_WRITE_TOKEN=
# Required with Vercel OIDC when BLOB_READ_WRITE_TOKEN is not used.
BLOB_STORE_ID=

# Required only when IAM credential setup/reset email delivery is enabled.
# Keep this workflow disabled unless all three are configured and approved.
APP_ORIGIN=
RESEND_API_KEY=
EMAIL_FROM=
