{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || pip install --quiet --user 'graphifyy==0.9.83' >/dev/null 2>&1 || true",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
